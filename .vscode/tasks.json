{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Mod (Select Configuration)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/SellMeSlave.sln",
                "/p:Configuration=${input:configuration}",
                "/p:SolutionDir=${workspaceFolder}/"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build MCM Bridge",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/SMS.MCMBridge/SMS.MCMBridge.csproj",
                "/p:Configuration=${input:configuration}",
                "/p:SolutionDir=${workspaceFolder}/"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ],
    "inputs": [
        {
            "id": "configuration",
            "description": "Select Build Configuration",
            "type": "pickString",
            "options": [
                "Debug",
                "Hotfix",
                "Update"
            ],
            "default": "Debug"
        }
    ]
}