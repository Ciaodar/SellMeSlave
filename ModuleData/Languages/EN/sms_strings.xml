<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" type="string">
  <tags>
    <tag language="English" />
  </tags>
  <strings>
    <!-- MCM Settings -->
    <string id="sms_mcm_name" text="Sell Me Slave" />
    <string id="sms_mcm_multiplier" text="Slave Price Multiplier" />
    <string id="sms_mcm_multiplier_hint" text="General multiplier for troop prices." />
    <string id="sms_mcm_general" text="General Settings" />
    <string id="sms_mcm_random" text="Enable Price Randomization" />
    <string id="sms_mcm_random_hint" text="Adds +/- 10% randomization to prices." />
    <string id="sms_mcm_roguery_multiplier" text="Roguery XP Multiplier" />
    <string id="sms_mcm_roguery_multiplier_hint" text="Multiplier for Roguery skill XP gain from illegal trades." />
    <string id="sms_mcm_honor_multiplier" text="Honor Loss Multiplier" />
    <string id="sms_mcm_honor_multiplier_hint" text="Multiplier for Honor loss from illegal trades. Set to 0 to disable." />
    <string id="sms_mcm_lord_multiplier" text="Hero Price Multiplier" />
    <string id="sms_mcm_lord_multiplier_hint" text="Specific multiplier for noble prisoners." />
    <string id="sms_mcm_enable_menu" text="Enable Buy Slave Menu" />
    <string id="sms_mcm_enable_menu_hint" text="Show the 'Buy prisoners' option in the tavern district." />
    <string id="sms_mcm_buymenu" text="Buy Slave Menu" />
    <string id="sms_mcm_min_slaves" text="Min Slaves Per Broker" />
    <string id="sms_mcm_min_slaves_hint" text="Minimum number of prisoners a broker can offer." />
    <string id="sms_mcm_max_slaves" text="Max Slaves Per Broker" />
    <string id="sms_mcm_max_slaves_hint" text="Maximum number of prisoners a broker can offer." />
    <string id="sms_mcm_stock_expire" text="Stock Expiration (Days)" />
    <string id="sms_mcm_stock_expire_hint" text="How many days before a broker's stock refreshes." />
    <string id="sms_mcm_max_lords" text="Max Hero Transfers" />
    <string id="sms_mcm_max_lords_hint" text="Maximum number of heroes you can buy at once." />
    <string id="sms_mcm_lord" text="Hero Purchase" />
    <string id="sms_mcm_lord_escape" text="Hero Escape Chance Per Day" />
    <string id="sms_mcm_lord_escape_hint" text="Daily chance for a purchased Hero to escape during transit." />
    <string id="sms_mcm_delivery_speed" text="Delivery Speed Multiplier" />
    <string id="sms_mcm_delivery_speed_hint" text="Higher values = slower delivery. 1.0 is default speed." />
    <string id="sms_mcm_clear_data" text="Clear All SMS Data" />
    <string id="sms_mcm_clear_data_hint" text="Enable this and load a save to clear all mod data. Disable after use." />
    <string id="sms_mcm_data" text="Data Management" />

    <!-- Menus and UI -->
    <string id="sms_buy_slaves_opt" text="Captive Trading" />
    <string id="sms_buyslaves_desc" text="The ransom broker has brought you to a secret area where slave trading takes place. 'Buying' slaves is illegal, and things are expensive on the black market. What will you do?" />
    <string id="sms_buy_troops_opt" text="Buy prisoner troops" />
    <string id="sms_buy_lord_opt" text="Buy a prisoner Hero" />
    <string id="sms_back_opt" text="Back" />
    <string id="sms_no_stock" text="The broker has no prisoners available at this time." />
    <string id="sms_no_lords" text="There are no captured heroes available in the realm." />
    <string id="sms_menu_title" text="Prisoner Broker" />
    <string id="sms_broker_name" text="Prisoner Broker" />
    <string id="sms_buy_header" text="Buy Prisoners" />
    <string id="sms_not_enough" text="Not enough gold. Cost: {COST}{GOLD_ICON}, Your gold: {GOLD}{GOLD_ICON}" />
    <string id="sms_cost_info" text="Total cost: {COST}{GOLD_ICON} | Remaining: {REMAINING}{GOLD_ICON}" />
    <string id="sms_bought_troops" text="You purchased {COUNT} prisoners for {COST}{GOLD_ICON}." />
    <string id="sms_roguery_xp_msg" text="Gained {XP} Roguery experience from illegal trade." />
    <string id="sms_lords_title" text="Captured Heroes of the realm" />
    <string id="sms_buy_lord_header" text="Buy Prisoner Heroes" />
    <string id="sms_max_lords" text="You can buy at most {MAX} Heroes at once." />
    <string id="sms_lord_no_gold" text="Not enough gold. Cost: {COST}{GOLD_ICON}, Your gold: {GOLD}{GOLD_ICON}" />
    <string id="sms_not_enough_gold" text="You don't have enough gold to buy this hero." />
    
    <!-- Lord Delivery Prompts -->
    <string id="sms_lord_purchased_title" text="Hero Purchased" />
    <string id="sms_lord_purchased_body" text="{LORD_NAME} has been purchased for {PRICE}{GOLD_ICON}.&#10;&#10;Estimated delivery time: {HOURS} hours (~{DAYS} days).&#10;&#10;Warning: The prisoner may attempt to escape during transit!" />
    <string id="sms_ok" text="Understood" />
    <string id="sms_lord_escaped_title" text="Hero Escaped!" />
    <string id="sms_lord_escaped_body" text="The prisoner {LORD_NAME} managed to escape from their guards during transit! The delivery has failed and your money is lost." />
    <string id="sms_lord_delivered_title" text="Hero Delivered" />
    <string id="sms_lord_delivered_body" text="{LORD_NAME} has arrived safely and is now your prisoner." />

    <!-- QOL Sell Shortcuts -->
    <string id="sms_sell_lords_opt" text="Sell only Heroes" />
    <string id="sms_sell_troops_opt" text="Sell only regular troops" />
    <string id="sms_sell_non_bandits_opt" text="Sell everything except bandits" />
    <string id="sms_sell_bandits_opt" text="Sell only bandits" />
    <string id="sms_sold_msg" text="You sold {COUNT} prisoners for {GOLD}{GOLD_ICON}." />

    <!-- Peace-time Lord Inquiry -->
    <string id="sms_lord_non_hostile_title" text="Noble Delivery (Peace)" />
    <string id="sms_lord_non_hostile_body" text="{LORD_NAME} has arrived. Since you are not at war with {FACTION_NAME}, keeping them will be seen as a criminal act. What will you do?" />
    <string id="sms_release_opt" text="Release (Relation +)" />
    <string id="sms_keep_opt" text="Keep as Prisoner (Crime ++)" />
    <string id="sms_lord_released_msg" text="You released {LORD_NAME}. Your relation with {CLAN_NAME} has increased." />
    <string id="sms_lord_kept_msg" text="You kept {LORD_NAME} as a prisoner. Your crime rating with {FACTION_NAME} has increased significantly." />

    <!-- Dialogue Trade & Exchange -->
    <string id="sms_trade_request" text="Are you interested in trading captives?" />
    <string id="sms_trade_dishonor" text="What do you take me for? I'm an honorable man!" />
    <string id="sms_trade_offer" text="What is your offer about?" />
    <string id="sms_buy_someone" text="I can pay good amount to buy someone you keep." />
    <string id="sms_buy_culprits" text="I need some culprits to put them in order." />
    <string id="sms_trade_agree" text="Be my guest, Its time for them to bring money to me, finally." />
    <string id="sms_cartel_request" text="I think we can arrange a cartel." />
    <string id="sms_cartel_rejected" text="I don't think so." />
    <string id="sms_cartel_ask_who" text="Whom do you want to be freed?" />
    <string id="sms_cartel_select" text="Select captive to exchange" />
    <string id="sms_cartel_proposal" text="Okay, I want {EXCHANGE_LORD_NAME} to be freed then." />
    <string id="sms_cartel_deal" text="Deal!" />
    <string id="sms_cartel_refuse" text="This is not a good deal for me." />
    <string id="sms_cartel_loss" text="Your loss." />
    <string id="sms_never_mind" text="Never mind." />
    <string id="sms_cartel_select_opt" text="Let me see who you have..." />
    <string id="sms_mcm_enable_exchange" text="Enable Prisoner Exchange" />
    <string id="sms_mcm_enable_exchange_hint" text="Enables the 'Cartel' mechanic to exchange captives with other lords." />
    <string id="sms_mcm_crime_multiplier" text="Crime Rating Multiplier" />
    <string id="sms_mcm_crime_multiplier_hint" text="Multiplier for criminal rating increase when buying slaves. Set to 0 to disable crime." />
    <string id="sms_mcm_relation_multiplier" text="Relation Gain Multiplier" />
    <string id="sms_mcm_relation_multiplier_hint" text="Multiplier for relation gain with the lord you buy prisoners from." />
  </strings>
</base>
