<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SMS.MCMBridge</RootNamespace>
    <AssemblyName>SMS.MCMBridge</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LibFolder>$(MSBuildProjectDirectory)\..\Libs</LibFolder>
    <GameFolder Condition="Exists('D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord')">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <ModuleName>SellMeSlave</ModuleName>
    <ModuleFolder>$(GameFolder)\Modules\$(ModuleName)</ModuleFolder>
    <Configurations>Debug;Update;Hotfix</Configurations>
    <SubModuleTemplatePath>$(ProjectDir)..\SubModule.xml</SubModuleTemplatePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMS\SMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MCMv5">
      <HintPath>$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <BridgeOutput Include="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeOutput)" DestinationFolder="$(ModuleFolder)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="@(BridgeOutput)" DestinationFolder="$(ModuleFolder)\bin\Gaming.Desktop.x64_Shipping_Client" />

    <!-- Automatically zip the updated module folder (with both SMS.dll and SMS.MCMBridge.dll) to Desktop -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;[xml]$xml = Get-Content '$(ModuleFolder)\SubModule.xml'; $ver = $xml.Module.Version.value; $dest = Join-Path ([Environment]::GetFolderPath('Desktop')) ('$(ModuleName)_' + $ver + '.zip'); Compress-Archive -Path '$(ModuleFolder)' -DestinationPath $dest -Force; Write-Host ('Created archive on Desktop: ' + $dest)&quot;" />
  </Target>
</Project>
